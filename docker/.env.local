# Local Apple Silicon (arm64) overrides for docker/docker-compose.local-arm64.yml.
#
# Committed on purpose: this file holds NO credentials. Secrets (CR login,
# MySQL root password, MinIO keys, gateway license) stay in docker/.env, which
# is gitignored. Both files are passed to compose, later wins:
#
#   docker compose --env-file docker/.env --env-file docker/.env.local \
#     -f docker/docker-compose.yml -f docker/docker-compose.local-arm64.yml up -d
#
# The values below mirror the defaults baked into the override file; edit this
# file to pin a different build on this host instead of touching compose.

# arm64 builds published by the CR registry (slow pulls, ~400 KB/s).
LOCAL_MYSQL_IMAGE=cr.dataelem.com/bisheng-mysql:8.0.39-linuxarm64
LOCAL_REDIS_IMAGE=cr.dataelem.com/bisheng-redis:7.2.4-linuxarm64
LOCAL_OPENFGA_IMAGE=cr.dataelem.com/dataelement/openfga:v1.15.2-dm-arm64
LOCAL_ETCD_IMAGE=cr.dataelem.com/bisheng-etcd:v3.5.13-linuxarm64
LOCAL_ELASTICSEARCH_IMAGE=cr.dataelem.com/bisheng-elasticsearch:8.12.2-linuxarm64

# These two come from Docker Hub, which this network cannot reach
# (registry-1.docker.io fails); they work here only because they were pulled
# earlier. Pullable alternatives on CR (verified via docker manifest inspect):
#   MinIO  - cr.dataelem.com/minio/minio:RELEASE.2023-03-20T20-16-18Z
#            (amd64 only — runs emulated on Apple Silicon)
#   Milvus - cr.dataelem.com/milvusdb/milvus:v2.5.10-arm64
#            (arm64, but 2.5.x; this venv pins pymilvus>=2.6, so mirror v2.6.11
#            into CR instead if a fresh native-arm64 pull is required)
LOCAL_MINIO_IMAGE=minio/minio:latest
# v2.6.11 matches pymilvus 2.6.15 (requires >=2.6,<3.0).
LOCAL_MILVUS_IMAGE=milvusdb/milvus:v2.6.11
